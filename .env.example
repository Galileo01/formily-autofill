# Development-only direct OpenRouter configuration.
# Copy this file to .env.local or .env. Both are ignored by Git.
# WXT exposes the development variables to extension code, so never put a production key here.
WXT_AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
WXT_AI_MODEL=openrouter/free

# Production built-in service: an OpenAI-compatible Gateway URL without a provider key.
# The Gateway keeps the real provider credential on the server.
# WXT_AI_GATEWAY_BASE_URL=https://your-gateway.example.com/v1
# WXT_AI_GATEWAY_MODEL=openrouter/free
